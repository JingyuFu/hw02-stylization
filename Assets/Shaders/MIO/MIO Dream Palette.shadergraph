{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "70b0d892f9db48c998d298b5f5cc96f2",
    "m_Title": "1. Real-time lighting",
    "m_Content": "World normal dot light direction, distance attenuation and shadow attenuation. Sum the main light and additional lights before quantizing.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1440,
        "y": -550,
        "width": 380,
        "height": 150
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "2a35d7ebb59743f088b15616a8779f8c",
    "m_Title": "2. Artist-controlled three-tone palette",
    "m_Content": "Adapted from Lab 03. Set highlight, midtone and shadow independently to match the MIO reference. Thresholds select bands; Smoothness softens transitions.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -600,
        "y": -200,
        "width": 380,
        "height": 150
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1b45282a64434fb7b01abdc02e90cb98",
    "m_Title": "3. Object UV hatching",
    "m_Content": "UV0 -> Shadow Scale -> custom seamless hatching texture. Ink is restricted to dark lighting regions and follows the mesh when the view changes. Pattern Strength = 0 disables it.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1100,
        "y": 1510,
        "width": 560,
